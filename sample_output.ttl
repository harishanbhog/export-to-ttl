@prefix campus: <https://xfloor.ai/campus#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xf: <https://xfloor.ai/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://xfloor.ai/ontology> a owl:Ontology ;
    rdfs:label "xFloor MVP Ontology Export" .

xf:Federation a owl:Class .
xf:Floor a owl:Class .
xf:HubFloor a owl:Class .
xf:LeafFloor a owl:Class .
xf:ChildFloor a owl:Class .
xf:NodeFloor a owl:Class .
xf:Block a owl:Class .
xf:User a owl:Class .

campus:UniversityFloor a owl:Class .
campus:InstitutionFloor a owl:Class .
campus:DepartmentFloor a owl:Class .
campus:FacultyFloor a owl:Class .
campus:StudentFloor a owl:Class .
campus:SectionFloor a owl:Class .
campus:CourseFloor a owl:Class .
campus:YearFloor a owl:Class .
campus:NewsBlock a owl:Class .
campus:QuizBlock a owl:Class .
campus:PollBlock a owl:Class .
campus:FeedBlock a owl:Class .

xf:setspr_uni a campus:UniversityFloor, xf:HubFloor ;
    xf:floorId "setspr_uni" ;
    xf:title "SETSPR University" ;
    xf:description "University federation root" ;
    xf:visibility "private" ;
    xf:isLeaf false ;
    xf:floorCategory "University Floor" ;
    xf:phoneNumber "9999999999" ;
    xf:emailId "university@example.org" ;
    xf:location "Mysuru" ;
    xf:hasChildFloor xf:setspr_inst ;
    xf:hasGlobalBlock xf:block_1776142090894,
        xf:block_1776142091308 .

xf:setspr_inst a campus:InstitutionFloor, xf:ChildFloor ;
    xf:floorId "setspr_inst" ;
    xf:title "SETSPR Institution" ;
    xf:description "Institution node" ;
    xf:visibility "private" ;
    xf:isLeaf false ;
    xf:floorCategory "Institution Floor" ;
    xf:phoneNumber "8888888888" ;
    xf:emailId "institution@example.org" ;
    xf:location "Mysuru" ;
    xf:hasParentFloor xf:setspr_uni ;
    xf:hasChildFloor xf:setspr_sdc_kan .

xf:setspr_sdc_kan a campus:DepartmentFloor, xf:ChildFloor ;
    xf:floorId "setspr_sdc_kan" ;
    xf:title "Department of Kannada" ;
    xf:description "Department of Kannada" ;
    xf:visibility "private" ;
    xf:isLeaf false ;
    xf:runtimeFloorId "1776142728171" ;
    xf:floorCategory "Department Floor" ;
    xf:phoneNumber "7777777777" ;
    xf:emailId "kannada@example.org" ;
    xf:location "Arts Block" ;
    xf:hasParentFloor xf:setspr_inst ;
    xf:hasChildFloor xf:setspr_sdc_kan_venkaborao .

xf:setspr_sdc_kan_venkaborao a campus:FacultyFloor, xf:NodeFloor ;
    xf:floorId "setspr_sdc_kan_venkaborao" ;
    xf:title "Dr Venkabo Rao M" ;
    xf:description "Department of Kannada" ;
    xf:visibility "private" ;
    xf:isLeaf true ;
    xf:runtimeFloorId "1776143034000" ;
    xf:floorCategory "Lecturer Floor" ;
    xf:phoneNumber "6666666666" ;
    xf:emailId "venkabo.rao@example.org" ;
    xf:location "Room 204" ;
    xf:hasParentFloor xf:setspr_sdc_kan .

xf:block_1776142091308 a campus:FeedBlock, xf:Block ;
    xf:blockId "1776142091308" ;
    xf:title "Feeds" ;
    xf:blockTypeCode "1" ;
    xf:inheritsToChildFloors true ;
    xf:isDerivedBlock true ;
    xf:isEditableByLocalOwner false ;
    xf:isDefaultBlock true ;
    xf:isLiveEnabled false ;
    xf:analyticsEnabled false ;
    xf:userAllowedToPost false ;
    xf:originFloor xf:setspr_uni .

xf:block_1776142090894 a campus:NewsBlock, xf:Block ;
    xf:blockId "1776142090894" ;
    xf:title "CampusNews" ;
    xf:blockTypeCode "0" ;
    xf:inheritsToChildFloors false ;
    xf:isDerivedBlock false ;
    xf:isEditableByLocalOwner true ;
    xf:isDefaultBlock false ;
    xf:isLiveEnabled true ;
    xf:analyticsEnabled false ;
    xf:userAllowedToPost false .
