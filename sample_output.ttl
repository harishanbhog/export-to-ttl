@prefix campus: <https://xfloor.ai/campus#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xf: <https://xfloor.ai/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://xfloor.ai/ontology> a owl:Ontology ;
    rdfs:label "xFloor MVP Ontology Export" .

xf:Federation a owl:Class .
xf:Floor a owl:Class .
xf:HubFloor a owl:Class .
xf:LeafFloor a owl:Class .
xf:Block a owl:Class .
xf:User a owl:Class .
campus:InstitutionFloor a owl:Class .
campus:DepartmentFloor a owl:Class .
campus:FacultyFloor a owl:Class .

xf:hasChildFloor a owl:ObjectProperty .
xf:hasParentFloor a owl:ObjectProperty .
xf:hasBlock a owl:ObjectProperty .

xf:floorId a owl:DatatypeProperty .
xf:runtimeFloorId a owl:DatatypeProperty .
xf:title a owl:DatatypeProperty .
xf:description a owl:DatatypeProperty .
xf:visibility a owl:DatatypeProperty .
xf:isLeaf a owl:DatatypeProperty .
xf:blockId a owl:DatatypeProperty .
xf:blockTypeCode a owl:DatatypeProperty .
xf:inheritsToChildFloors a owl:DatatypeProperty .
xf:isDefaultBlock a owl:DatatypeProperty .
xf:isLiveEnabled a owl:DatatypeProperty .
xf:analyticsEnabled a owl:DatatypeProperty .
xf:userAllowedToPost a owl:DatatypeProperty .

xf:setspr a xf:Federation, xf:Floor, xf:HubFloor ;
    xf:floorId "setspr" ;
    xf:isLeaf false ;
    xf:title "setspr" ;
    xf:visibility "private" ;
    xf:hasChildFloor xf:setspr_sdc_kan ;
    xf:hasBlock xf:block_1776142091308, xf:block_1776142090894 .

xf:setspr_sdc_kan a campus:DepartmentFloor, xf:Floor, xf:HubFloor ;
    xf:description "Department of Kannada" ;
    xf:floorId "setspr_sdc_kan" ;
    xf:hasChildFloor xf:setspr_sdc_kan_venkaborao ;
    xf:hasParentFloor xf:setspr ;
    xf:isLeaf false ;
    xf:runtimeFloorId "1776142728171" ;
    xf:title "Department of Kannada" ;
    xf:visibility "private" .

xf:setspr_sdc_kan_venkaborao a campus:FacultyFloor, xf:Floor, xf:LeafFloor ;
    xf:description "Department of Kannada" ;
    xf:floorId "setspr_sdc_kan_venkaborao" ;
    xf:hasParentFloor xf:setspr_sdc_kan ;
    xf:isLeaf true ;
    xf:runtimeFloorId "1776143034000" ;
    xf:title "Dr Venkabo Rao M" ;
    xf:visibility "private" .

xf:block_1776142091308 a xf:Block ;
    xf:analyticsEnabled false ;
    xf:blockId "1776142091308" ;
    xf:blockTypeCode "1" ;
    xf:inheritsToChildFloors true ;
    xf:isDefaultBlock true ;
    xf:isLiveEnabled false ;
    xf:title "Feeds" ;
    xf:userAllowedToPost false .

xf:block_1776142090894 a xf:Block ;
    xf:analyticsEnabled false ;
    xf:blockId "1776142090894" ;
    xf:blockTypeCode "0" ;
    xf:inheritsToChildFloors false ;
    xf:isDefaultBlock false ;
    xf:isLiveEnabled true ;
    xf:title "CampusNews" ;
    xf:userAllowedToPost false .
